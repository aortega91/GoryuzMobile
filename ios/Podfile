def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions([
  'Camera',
  'PhotoLibrary',
  'LocationWhenInUse',
])

linkage = :static
$RNFirebaseAsStaticFramework = true
Pod::UI.puts "Configuring Pod with statically linked Frameworks".green
use_frameworks! :linkage => linkage


target 'GoryuzMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # @react-native-firebase files import certain React headers (RCTBridgeModule.h,
    # RCTConvert.h) via a non-modular header search path. When RNFBApp (compiled first
    # as a static framework) textually includes the same header, Clang claims the symbol
    # as belonging to the RNFBApp module. Subsequent compilation of any other RNFB module
    # importing the React header directly then fails with "must be imported from module
    # RNFBApp.X before it is required".
    # Fix: import through the RNFBApp framework module directly for each affected header,
    # which already exposes the symbol via its umbrella, so it's accessed through the
    # proper module. Each substitution skips the RNFBApp files that own the symbol and
    # must keep their direct React import.
    rnfb_root = "#{Pod::Config.instance.installation_root}/../node_modules/@react-native-firebase"
    substitutions = [
      {
        from: '#import <React/RCTBridgeModule.h>',
        to: '#import <RNFBApp/RNFBAppModule.h>',
        skip: ['RNFBAppModule.h'],
      },
      {
        from: '#import <React/RCTConvert.h>',
        to: '#import <RNFBApp/RCTConvert+FIRApp.h>',
        skip: ['RCTConvert+FIRApp.h', 'RCTConvert+FIRApp.m', 'RCTConvert+FIROptions.h', 'RCTConvert+FIROptions.m'],
      },
    ]
    Dir.glob("#{rnfb_root}/*/ios/**/*.{h,m}").each do |file|
      content = File.read(file)
      patched = content
      substitutions.each do |sub|
        next if sub[:skip].include?(File.basename(file))

        patched = patched.gsub(sub[:from], sub[:to])
      end
      if patched != content
        File.write(file, patched)
        Pod::UI.puts "Patched #{File.basename(file)}".green
      end
    end

  end
end
